# Nebius Token Factory / Nebius AI Cloud Configuration
# Endpoint must be the official Nebius Token Factory OpenAI-compatible API
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=your_nebius_api_key_here

# NVIDIA Open-Source Nemotron Models hosted on Nebius
NEBIUS_MODEL_NANO=nvidia/nemotron-3-nano-30b-a3b
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b

# Tavily Web Research API Configuration
TAVILY_API_KEY=your_tavily_api_key_here
